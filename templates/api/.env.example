# Пример env для разработки. Скопируй в .env и заполни. Боевые значения — только в env приложения в Dokploy.

PORT=4000
NODE_ENV=development

# Локальная база из docker-compose.yml в корне проекта.
# На проде — внутренний адрес базы в Dokploy (<appName>:5432), только в env Dokploy.
DATABASE_URL=postgresql://dev:dev@localhost:5432/app

# openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Адреса фронтов через запятую. На проде только https.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Пусто — кука только на хосте API.
COOKIE_DOMAIN=

# Фоновые задачи: в разработке выключены, на проде true.
WORKERS_ENABLED=false

# Необязательное: пусто — функция выключена и отвечает 503, остальное работает.
# Telegram-бот напоминаний (@BotFather).
TELEGRAM_BOT_TOKEN=
# Прокси до Telegram, если сервер в России. Пусто — напрямую.
TELEGRAM_PROXY_URL=
# S3-хранилище для файлов.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
